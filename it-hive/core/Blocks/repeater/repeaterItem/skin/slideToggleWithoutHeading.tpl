<div class="row repeaterItem postbox closed" data-control-type="repeaterItem" id="{{id}}">
    <button type="button" class="handlediv" aria-expanded="false"><span class="screen-reader-text">Toggle panel: Top Slider</span><span class="toggle-indicator" aria-hidden="true"></span></button>
    <h4 class="hndle-header">{{heading}}</h4>
    <div class="inside">
        {{children}}
        <div class="btn-controls">
            <a href="#" class="delete-repeaterItem" data-parent-control="{{id}}" style="color: red">{{removeText}}</a>
        </div>
    </div>
</div>